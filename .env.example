# LiveWiki 配置示例（复制为 .env 后填写，.env 已被 .gitignore 忽略，不会提交）

# ── 自动导出转写结果到 Obsidian wiki 目录 ──
# 不设置则不导出；设置后每次转写会自动生成带 frontmatter 的 .md 笔记
LW_WIKI_DIR=/Users/a1-6/AI Shared/wiki

# ── HuggingFace Token（可选，用于 pyannote 发言人识别）──
HF_TOKEN=

# ── 真实 LLM 生成式归纳（可选）──
# 不配置 → 自动回退到内置规则引擎（关键词归纳 + 抽取式要点）
# 配置后 → 摘要 / 要点 / 关键词由大模型用自有语言重写，不再摘录原文
# 支持多供应商链：按 LW_LLM_PROVIDER 顺序尝试，前一个失败自动切下一个，全部失败回退规则引擎。

# 供应商尝试顺序（逗号分隔），默认 stepfun,nvidia,custom
LW_LLM_PROVIDER=stepfun,nvidia
LW_LLM_TEMPERATURE=0.3

# 阶跃星辰 StepFun（https://platform.stepfun.com）
# 可选模型：step-3.5-flash（语言推理旗舰）/ step-3.7-flash（多模态推理）
LW_STEPFUN_API_KEY=
LW_STEPFUN_BASE_URL=https://api.stepfun.com/v1
LW_STEPFUN_MODEL=step-3.5-flash

# 英伟达 NVIDIA NIM（https://build.nvidia.com）
# 可选模型：meta/llama-3.3-70b-instruct / deepseek-ai/deepseek-v4-pro / qwen/qwen3-next-80b-a3b-instruct / openai/gpt-oss-120b
LW_NVIDIA_API_KEY=
LW_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LW_NVIDIA_MODEL=qwen/qwen3-next-80b-a3b-instruct

# 自定义 OpenAI 兼容端点（可选，向后兼容；OpenAI / DeepSeek / 硅基流动 / Ollama 等）
LW_LLM_API_KEY=
LW_LLM_BASE_URL=https://api.openai.com/v1
LW_LLM_MODEL=gpt-4o-mini
